# ---------------------------- Telegram ----------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---------------------- Vasl / MeowTunes --------------------------
# Public JSON API (vasl.social/api returns the SPA shell — use api2)
VASL_API_BASE=https://api2.vasl.social/api
# Public media CDN used by the web player
VASL_CDN_BASE=https://cdn.v-storage.cloud

# ---------------------------- Runtime -----------------------------
DATABASE_PATH=data/meowtunes.sqlite3
# How often to poll /music/liked for linked accounts (seconds)
FAV_POLL_SECONDS=15
HTTP_TIMEOUT_SECONDS=25
MAX_RETRIES=3
# Telegram bot upload limit is 50 MB
MAX_AUDIO_MB=45
# Items per page in result lists
PAGE_SIZE=8
LOG_LEVEL=INFO
